# Project-predefined release signing (committed). Used when the matching
# keys in apk-forge/server/.env are empty. Override via .env or the UI.
# Keystore: app/signing/template-release.jks (repo root relative).
RELEASE_KEYSTORE_FILE=app/signing/template-release.jks
RELEASE_STORE_PASSWORD=template
RELEASE_KEY_ALIAS=template
RELEASE_KEY_PASSWORD=template
